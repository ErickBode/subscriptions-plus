{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subscriptions+",
  "version": "1.1.0",
  "identifier": "com.erickbode.subscriptionsplus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Subscriptions+",
        "width": 1240,
        "height": 800,
        "minWidth": 420,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#232323"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
